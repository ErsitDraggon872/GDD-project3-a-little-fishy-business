.Item {
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    align-content: center;
    width: 120px;
    height: 120px;
    max-width: 120px;
    max-height: 120px;
}

.GridSlot:hover {
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
}

.Grid {
    flex-grow: 1;
    background-color: rgba(199, 150, 75, 0.84);
    width: 512px;
    height: 512px;
    max-width: 512px;
    max-height: 512px;
    align-self: flex-start;
    align-content: flex-start;
    justify-content: flex-start;
    flex-direction: row;
    flex-wrap: wrap;
    flex-basis: auto;
}

.GridSlot {
    background-color: rgba(199, 150, 75, 0.84);
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    border-left-color: rgba(0, 0, 0, 0.3);
    border-right-color: rgba(0, 0, 0, 0.3);
    border-top-color: rgba(0, 0, 0, 0.3);
    border-bottom-color: rgba(0, 0, 0, 0.3);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
}

.GridSlotTemplateContainer {
    width: 25%;
    height: 25%;
}

.Hotbar {
    flex-grow: 1;
    background-color: rgba(45, 87, 99, 0.75);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgba(15, 34, 59, 0.46);
    border-right-color: rgba(15, 34, 59, 0.46);
    border-top-color: rgba(15, 34, 59, 0.46);
    border-bottom-color: rgba(15, 34, 59, 0.46);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    width: 128px;
    max-width: 150px;
    height: 512px;
    justify-content: flex-start;
    align-items: flex-start;
    flex-wrap: wrap;
    align-self: center;
    margin-left: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}
